# ============================================================
#  EXAMPLE — copy this to create your own .env files
#  DO NOT put real passwords here — this file is safe to commit
# ============================================================

APP_ENV=local   # local | dev | prod

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/learning_management_system

# JWT — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-strong-random-hex-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# App Settings
DEBUG=True   # set False in production
